# --- ingest box ---
APRSIS_HOST=rotate.aprs2.net
APRSIS_PORT=14580
APRSIS_CALLSIGN=N0CALL
# -1 = receive-only (no transmit)
APRSIS_PASSCODE=-1
# OE example: ~Graz, 300km
APRSIS_FILTER=r/47.07/15.42/300
INGEST_URL=http://127.0.0.1:8787/ingest
# REQUIRED — the same value the gateway has. Generate one: openssl rand -hex 24 (the gateway refuses the
# change-me default). It is the only gateway secret this box holds: never put OPERATOR_SECRET or
# SESSION_SECRET here.
INGEST_SECRET=
BATCH_MS=1500

# --- APRS-IS uplink: answers to radio commands, announced finds, weather ---
# Blank: a box whose APRSIS_CALLSIGN shares the gateway's service-call base call logs in as the
# service call with APRSIS_PASSCODE. Set both to log in as another call of that base call.
APRSIS_SERVICE_CALL=
APRSIS_SERVICE_PASS=

# --- optional: extra transports (each forwards to /ingest with its own port) ---
# KISS-over-TCP TNC (e.g. Direwolf): set host to enable.
KISS_TNC_HOST=
KISS_TNC_PORT=8001
# RF digipeater (needs a KISS TNC). Set DIGI_CALL to your station call to enable n-N repeating.
DIGI_CALL=
DIGI_ALIASES=WIDE1,WIDE2
# APRS IGate (needs a KISS TNC + a real callsign & its APRS-IS passcode). Passes RF up to APRS-IS.
IGATE_CALL=
IGATE_PASS=
# "1" also passes APRS-IS messages for stations heard locally down to RF (transmits; off by default).
IGATE_TX=
# APRS-IS filter for the IS->RF (message) direction
IGATE_FILTER=t/m
# seconds a station counts as "heard locally" for TX-gating
IGATE_LOCAL_TTL=1800
# RF path of messages gated IS->RF, comma-separated (blank = direct; e.g. WIDE1-1 to reach one hop out)
IGATE_TX_PATH=
# IS->RF pacing: messages gated at once, then one more every N seconds (ceiling: 10 at once, 6 s)
IGATE_TX_BURST=6
IGATE_TX_REFILL_SEC=10
# Callsign naming this box as the receiving site of frames its KISS / AGWPE / host-mode TNC hears
# directly (default: IGATE_CALL). Those frames count toward Tier A once the call is trusted at the gateway,
# under Instance admin → Trusted receiving stations (or listed in FIRST_PARTY_SITES). Only for a TNC you
# operate: leave it blank when the TNC host is someone else's station.
RF_SITE_CALL=
# Meshtastic — licensed nodes only (licensed/ham mode on, callsign as long name). Either the node's TCP
# API (a WiFi/Ethernet node, port 4403) or a broker's protobuf feed, e.g. mqtt://user:pass@broker.
MESHTASTIC_HOST=
MESHTASTIC_PORT=4403
MESHTASTIC_MQTT_URL=
MESHTASTIC_MQTT_TOPIC=msh/#
# MeshCom (LoRa ham mesh) via the nodes' ExtUDP interface (on the node: --extudpip <this box> + --extudp on).
# MESHCOM_NODE lists the allowed node address(es), each optionally =CALL, e.g. 192.168.1.50=OE8APR-12.
# The node's call marks its own frames and, for a direct LoRa hearing, names it as the receiving site
# (trusted at the gateway under Instance admin → Trusted receiving stations, or listed in FIRST_PARTY_SITES).
MESHCOM_NODE=
MESHCOM_PORT=1799
# Blank = this host's address on the node's subnet. Never 0.0.0.0 on a host reachable from the internet.
MESHCOM_BIND=
# Other local tools that also want the raw datagrams, e.g. 127.0.0.1:1800 (only one process can own 1799).
MESHCOM_FANOUT=
# Max datagrams per second per node, and minutes of silence before a warning.
MESHCOM_RATE=20
MESHCOM_STALE_MIN=30
# "1" lets the box answer radio commands (FOUND / DNF / NOTE / HELP) through its MeshCom nodes. Needs
# BOX_ID and BOX_TX=1. The node transmits under its own call, which must match MESHCOM_TX_CALL
# (blank = BOX_CALL, then IGATE_CALL, DIGI_CALL).
MESHCOM_TX=
MESHCOM_TX_CALL=
# Send pacing: sends at once, then one more every N seconds (ceiling: 10 at once, 6 s)
MESHCOM_TX_BURST=3
MESHCOM_TX_REFILL_SEC=60
# The first node's KISS password (the node needs --kiss on, --kiss tx on, --kiss auth on and --passwd).
# With it, answers and Mailbox messages go out from the gateway's service call instead of the node's call.
MESHCOM_KISS_PASS=

# --- optional: remote control from the web app (Shack -> Remote control) ---
# The box polls the gateway for commands you queue in the app; no inbound port is opened.
# BOX_ID is the id you enter in the app. At start the box prints a one-time pairing code; enter it in the
# app to link the box to your account. Status and switching functions off work with BOX_ID alone.
BOX_ID=
# "1" lets queued commands transmit (beacon, message, switching digi/IGate/TX on).
BOX_TX=
# The station call remote transmits must use (base call match; blank = IGATE_CALL, then DIGI_CALL).
BOX_CALL=
# Digipeater path for remote beacons and messages (blank = no path).
BOX_TX_PATH=WIDE1-1,WIDE2-1
# Refuse transmit commands queued longer ago than this many seconds.
BOX_CMD_MAX_AGE=900
# Remote-transmit pacing: transmits at once, then one more every N seconds (ceiling: 10 at once, 6 s)
BOX_TX_BURST=3
BOX_TX_REFILL_SEC=60

# --- gateway position storage: set these on the GATEWAY (deploy/.env, or [vars] in workers/gateway/wrangler.toml
# on the Cloudflare split), not on this box; see docs/reference/cloudflare-costs.md "Cost on D1" ---
# A fix is stored once its station has moved POS_MIN_MOVE_M metres or POS_MIN_INTERVAL_S seconds have passed
# since its last stored fix. Accounts' calls, registered stations, open finds, living caches and every fix
# heard directly on RF are always stored; every fix still reaches the live map. 0 in either stores every fix.
# POS_MIN_MOVE_M=25
# POS_MIN_INTERVAL_S=600
# Daily D1 write budget (rows a day, from 00:00 UTC; on the Worker 1500000 unless set, 90000 on Workers Free;
# on Node/Bun off unless set; 0 = off): near it the gateway stops storing low-value writes and alerts the sysop.
# See docs/reference/cloudflare-costs.md "Write budget".
# D1_DAILY_WRITE_BUDGET=1500000

# --- gateway embeddable map widget (/embed): set these on the GATEWAY too, not on this box ---
# A MapLibre style URL, or "offline" for the self-contained grid that loads nothing from outside the
# instance (HAMNET, off-grid). Unset: OpenFreeMap liberty, the web app's default basemap.
# BASEMAP_STYLE=offline
# Extra origins the style loads tiles, glyphs or sprites from, when they are not on the style's own host.
# BASEMAP_HOSTS=

# --- optional: ingest tuning ---
# max packets buffered (drop-oldest) while the gateway is unreachable
INGEST_SPOOL_MAX=5000

# --- optional: connected-mode digipeater (needs DIGI_CALL + a KISS TNC) ---
# "1" to also repeat SABM/I/… frames (NET/ROM + FBB relay through us)
DIGI_CONNECTED=
# viscous-delay ms before repeating (lets a better-placed digi win); blank = off
DIGI_VISCOUS_MS=

# --- optional: NET/ROM node (needs a KISS TNC) ---
# our node's callsign-SSID, e.g. OE8XXX-7 — set with NETROM_ALIAS to enable
NETROM_CALL=
# node alias, e.g. GRAZ
NETROM_ALIAS=
# NODES broadcast interval ms (blank = spec default ~300000)
NETROM_BROADCAST_MS=
# link quality assumed for a directly-heard neighbour (blank = 192)
NETROM_PATH_QUALITY=
# "1" also speaks INP3 (triggered RIFs + RTT metric) alongside NODES
NETROM_INP3=
# node command surface: netrom (default) | flexnet | tnn | baycom
NODE_PERSONALITY=

# --- optional: connected-mode BBS answering inbound connects (needs a KISS TNC) ---
# our BBS callsign-SSID, e.g. OE8XXX-1 — set to enable
BBS_NODE_CALL=

# --- optional: FBB mail forwarding to partner BBSes (needs a KISS TNC) ---
# "1" to enable the forwarding scheduler
BBS_FORWARD=
# our station call used for the forwarding session
BBS_FORWARD_CALL=
# our advertised SID (blank = a sensible default)
BBS_FORWARD_SID=
# how often to check partners for due forwards
BBS_FORWARD_POLL_MS=60000
# "1" offers LZHUF-B1 compressed forwarding (falls back to ASCII per partner)
BBS_FORWARD_COMPRESS=
# Session pacing: forwarding sessions at once, then one more every N seconds (ceiling: 10 at once, 60 s);
# a partner over the limit waits for the next poll
BBS_FORWARD_BURST=4
BBS_FORWARD_REFILL_SEC=300

# --- optional: AGWPE TNC (Direwolf/SoundModem/UZ7HO over TCP) ---
# set to enable
AGWPE_HOST=
AGWPE_PORT=8000
# AGWPE radio-port index (0 = first)
AGWPE_RADIO_PORT=0

# --- optional: WA8DED host-mode TNC (TF firmware / TFPCX over TCP) ---
# set to enable
HOSTMODE_HOST=
HOSTMODE_PORT=3694
# station call the host-mode TNC uses
HOSTMODE_MYCALL=
# host-mode radio-port index (0 = first)
HOSTMODE_RADIO_PORT=0

# --- optional: AXUDP tunnel (tunnelled AX.25 over UDP — always Tier C, never first-party RF) ---
# set the listen port to enable (default 10093 if enabled without a value)
AXUDP_PORT=
# bind address (blank = all interfaces)
AXUDP_BIND=
# host:port,host:port — with peers it's a bidirectional KISS-equivalent port
AXUDP_PEERS=

# --- optional: AXIP tunnel (AX.25 over IP; reserved seam) ---
# "1" to enable
AXIP_ENABLE=
AXIP_BIND=
AXIP_PEERS=

# --- optional: CWOP relay (feeds NOAA; falls back to standard APRS-IS when unset) ---
CWOP_HOST=
CWOP_PORT=14580
