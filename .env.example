# --- ingest box ---
APRSIS_HOST=rotate.aprs2.net
APRSIS_PORT=14580
APRSIS_CALLSIGN=N0CALL
# -1 = receive-only (no transmit)
APRSIS_PASSCODE=-1
# OE example: ~Graz, 300km
APRSIS_FILTER=r/47.07/15.42/300
INGEST_URL=http://127.0.0.1:8787/ingest
# REQUIRED — generate one: openssl rand -hex 24 (gateway refuses the old change-me default)
INGEST_SECRET=
BATCH_MS=1500

# --- optional: APRS-IS announce uplink (publishes opt-in finds) ---
# Service callsign + its APRS-IS passcode (passcode derives from the callsign).
# Leave blank to disable announce publishing entirely.
APRSIS_SERVICE_CALL=
APRSIS_SERVICE_PASS=

# --- optional: extra transports (each forwards to /ingest with its own port) ---
# KISS-over-TCP TNC (e.g. Direwolf): set host to enable.
KISS_TNC_HOST=
KISS_TNC_PORT=8001
# RF digipeater (needs a KISS TNC). Set DIGI_CALL to your station call to enable n-N repeating.
DIGI_CALL=
DIGI_ALIASES=WIDE1,WIDE2
# Bidirectional APRS IGate (needs a KISS TNC + a real callsign & APRS-IS passcode for TX).
IGATE_CALL=
IGATE_PASS=
# APRS-IS filter for the IS->RF (message) direction
IGATE_FILTER=t/m
# seconds a station counts as "heard locally" for TX-gating
IGATE_LOCAL_TTL=1800
# TAK/CoT inbound (UDP): set the port to enable an ATAK/WinTAK feed listener.
TAK_COT_PORT=
TAK_COT_BIND=0.0.0.0
# Meshtastic via newline-JSON over TCP (point at an MQTT->TCP bridge / mosquitto_sub feed).
MESH_HOST=
MESH_PORT=1884
# MeshCom (LoRa ham mesh) via the nodes' ExtUDP interface (on the node: --extudpip <this box> + --extudp on).
# RX-only. MESHCOM_NODE lists the allowed node address(es), each optionally =CALL, e.g. 192.168.1.50=OE8APR-12.
# The node's call marks its own frames and, for a direct LoRa hearing, names it as the receiving site
# (attest it at the gateway with FIRST_PARTY_SITES).
MESHCOM_NODE=
MESHCOM_PORT=1799
# Blank = this host's address on the node's subnet. Never 0.0.0.0 on a host reachable from the internet.
MESHCOM_BIND=
# Other local tools that also want the raw datagrams, e.g. 127.0.0.1:1800 (only one process can own 1799).
MESHCOM_FANOUT=
# Max datagrams per second per node, and minutes of silence before a warning.
MESHCOM_RATE=20
MESHCOM_STALE_MIN=30

# --- optional: ingest tuning ---
# max packets buffered (drop-oldest) while the gateway is unreachable
INGEST_SPOOL_MAX=5000

# --- optional: connected-mode digipeater (needs DIGI_CALL + a KISS TNC) ---
# "1" to also repeat SABM/I/… frames (NET/ROM + FBB relay through us)
DIGI_CONNECTED=
# viscous-delay ms before repeating (lets a better-placed digi win); blank = off
DIGI_VISCOUS_MS=

# --- optional: NET/ROM node (needs a KISS TNC) ---
# our node's callsign-SSID, e.g. OE8XXX-7 — set with NETROM_ALIAS to enable
NETROM_CALL=
# node alias, e.g. GRAZ
NETROM_ALIAS=
# NODES broadcast interval ms (blank = spec default ~300000)
NETROM_BROADCAST_MS=
# link quality assumed for a directly-heard neighbour (blank = 192)
NETROM_PATH_QUALITY=
# "1" also speaks INP3 (triggered RIFs + RTT metric) alongside NODES
NETROM_INP3=
# node command surface: netrom (default) | flexnet | tnn | baycom
NODE_PERSONALITY=

# --- optional: connected-mode BBS answering inbound connects (needs a KISS TNC) ---
# our BBS callsign-SSID, e.g. OE8XXX-1 — set to enable
BBS_NODE_CALL=

# --- optional: FBB mail forwarding to partner BBSes (needs a KISS TNC) ---
# "1" to enable the forwarding scheduler
BBS_FORWARD=
# our station call used for the forwarding session
BBS_FORWARD_CALL=
# our advertised SID (blank = a sensible default)
BBS_FORWARD_SID=
# how often to check partners for due forwards
BBS_FORWARD_POLL_MS=60000
# "1" offers LZHUF-B1 compressed forwarding (falls back to ASCII per partner)
BBS_FORWARD_COMPRESS=

# --- optional: AGWPE TNC (Direwolf/SoundModem/UZ7HO over TCP) ---
# set to enable
AGWPE_HOST=
AGWPE_PORT=8000
# AGWPE radio-port index (0 = first)
AGWPE_RADIO_PORT=0

# --- optional: WA8DED host-mode TNC (TF firmware / TFPCX over TCP) ---
# set to enable
HOSTMODE_HOST=
HOSTMODE_PORT=3694
# station call the host-mode TNC uses
HOSTMODE_MYCALL=
# host-mode radio-port index (0 = first)
HOSTMODE_RADIO_PORT=0

# --- optional: AXUDP tunnel (tunnelled AX.25 over UDP — always Tier C, never first-party RF) ---
# set the listen port to enable (default 10093 if enabled without a value)
AXUDP_PORT=
# bind address (blank = all interfaces)
AXUDP_BIND=
# host:port,host:port — with peers it's a bidirectional KISS-equivalent port
AXUDP_PEERS=

# --- optional: AXIP tunnel (AX.25 over IP; reserved seam) ---
# "1" to enable
AXIP_ENABLE=
AXIP_BIND=
AXIP_PEERS=

# --- optional: CWOP relay (feeds NOAA; falls back to standard APRS-IS when unset) ---
CWOP_HOST=
CWOP_PORT=14580
