# --- ingest box ---
APRSIS_HOST=rotate.aprs2.net
APRSIS_PORT=14580
APRSIS_CALLSIGN=N0CALL
APRSIS_PASSCODE=-1               # -1 = receive-only (no transmit)
APRSIS_FILTER=r/47.07/15.42/300  # OE example: ~Graz, 300km
INGEST_URL=http://127.0.0.1:8787/ingest
INGEST_SECRET=                  # REQUIRED — generate one: openssl rand -hex 24 (gateway refuses the old change-me default)
BATCH_MS=1500

# --- optional: APRS-IS announce uplink (publishes opt-in finds) ---
# Service callsign + its APRS-IS passcode (passcode derives from the callsign).
# Leave blank to disable announce publishing entirely.
APRSIS_SERVICE_CALL=
APRSIS_SERVICE_PASS=

# --- optional: extra transports (each forwards to /ingest with its own port) ---
# KISS-over-TCP TNC (e.g. Direwolf): set host to enable.
KISS_TNC_HOST=
KISS_TNC_PORT=8001
# RF digipeater (needs a KISS TNC). Set DIGI_CALL to your station call to enable n-N repeating.
DIGI_CALL=
DIGI_ALIASES=WIDE1,WIDE2
# Bidirectional APRS IGate (needs a KISS TNC + a real callsign & APRS-IS passcode for TX).
IGATE_CALL=
IGATE_PASS=
IGATE_FILTER=t/m            # APRS-IS filter for the IS->RF (message) direction
IGATE_LOCAL_TTL=1800        # seconds a station counts as "heard locally" for TX-gating
# TAK/CoT inbound (UDP): set the port to enable an ATAK/WinTAK feed listener.
TAK_COT_PORT=
TAK_COT_BIND=0.0.0.0
# Meshtastic via newline-JSON over TCP (point at an MQTT->TCP bridge / mosquitto_sub feed).
MESH_HOST=
MESH_PORT=1883

# --- optional: ingest tuning ---
INGEST_SPOOL_MAX=5000       # max packets buffered (drop-oldest) while the gateway is unreachable

# --- optional: connected-mode digipeater (needs DIGI_CALL + a KISS TNC) ---
DIGI_CONNECTED=             # "1" to also repeat SABM/I/… frames (NET/ROM + FBB relay through us)
DIGI_VISCOUS_MS=           # viscous-delay ms before repeating (lets a better-placed digi win); blank = off

# --- optional: NET/ROM node (needs a KISS TNC) ---
NETROM_CALL=               # our node's callsign-SSID, e.g. OE8XXX-7 — set with NETROM_ALIAS to enable
NETROM_ALIAS=              # node alias, e.g. GRAZ
NETROM_BROADCAST_MS=       # NODES broadcast interval ms (blank = spec default ~300000)
NETROM_PATH_QUALITY=       # link quality assumed for a directly-heard neighbour (blank = 192)
NETROM_INP3=               # "1" also speaks INP3 (triggered RIFs + RTT metric) alongside NODES
NODE_PERSONALITY=          # node command surface: netrom (default) | flexnet | tnn | baycom

# --- optional: connected-mode BBS answering inbound connects (needs a KISS TNC) ---
BBS_NODE_CALL=             # our BBS callsign-SSID, e.g. OE8XXX-1 — set to enable

# --- optional: FBB mail forwarding to partner BBSes (needs a KISS TNC) ---
BBS_FORWARD=               # "1" to enable the forwarding scheduler
BBS_FORWARD_CALL=          # our station call used for the forwarding session
BBS_FORWARD_SID=           # our advertised SID (blank = a sensible default)
BBS_FORWARD_POLL_MS=60000  # how often to check partners for due forwards
BBS_FORWARD_COMPRESS=      # "1" offers LZHUF-B1 compressed forwarding (falls back to ASCII per partner)

# --- optional: AGWPE TNC (Direwolf/SoundModem/UZ7HO over TCP) ---
AGWPE_HOST=                # set to enable
AGWPE_PORT=8000
AGWPE_RADIO_PORT=0         # AGWPE radio-port index (0 = first)

# --- optional: WA8DED host-mode TNC (TF firmware / TFPCX over TCP) ---
HOSTMODE_HOST=             # set to enable
HOSTMODE_PORT=3694
HOSTMODE_MYCALL=           # station call the host-mode TNC uses
HOSTMODE_RADIO_PORT=0      # host-mode radio-port index (0 = first)

# --- optional: AXUDP tunnel (tunnelled AX.25 over UDP — always Tier C, never first-party RF) ---
AXUDP_PORT=                # set the listen port to enable (default 10093 if enabled without a value)
AXUDP_BIND=                # bind address (blank = all interfaces)
AXUDP_PEERS=               # host:port,host:port — with peers it's a bidirectional KISS-equivalent port

# --- optional: AXIP tunnel (AX.25 over IP; reserved seam) ---
AXIP_ENABLE=               # "1" to enable
AXIP_BIND=
AXIP_PEERS=

# --- optional: CWOP relay (feeds NOAA; falls back to standard APRS-IS when unset) ---
CWOP_HOST=
CWOP_PORT=14580
