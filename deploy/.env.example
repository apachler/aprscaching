# ---- Public site (leave DOMAIN as :80 for local/off-grid; set a hostname for TLS) ----
DOMAIN=:80

# ---- APRS-IS feed ----
APRSIS_HOST=rotate.aprs2.net
APRSIS_PORT=14580
APRSIS_CALLSIGN=N0CALL          # your callsign
APRSIS_PASSCODE=00000           # your APRS-IS passcode
APRSIS_FILTER=r/47.07/15.42/300 # example: 300km around Vienna; tune to your area
BATCH_MS=2000

# ---- Gateway link ----
# Local/all-in-one: http://gateway:8080/ingest   (compose default)
# Remote (Topology 4): https://gateway.<you>.workers.dev/ingest
INGEST_URL=http://gateway:8080/ingest
INGEST_SECRET=                  # REQUIRED — setup.sh generates one (openssl rand -hex 24). Per-operator peer keys for shared gateways.

# ---- Trust / verification ----
# Tier A (RF-corroborated) is DEFAULT-DENY: a find reaches Tier A only when its gating IGate is a
# site you operate and attest. List those callsigns here (comma/space separated). Leave it EMPTY and
# NO find reaches Tier A locally — the APRS-IS firehose carries arbitrary IGates, so a bare qAR is not
# proof you heard the frame. Peer corroboration over federation can still grant Tier A independently.
# FIRST_PARTY_SITES=OE8XXX,OE8YYY

# ---- Home tunnel (Topology 1) ----
TUNNEL_TOKEN=

# ---- Backups ----
# deploy/backup.sh snapshots the SQLite DB nightly and UPLOADS it — it fails loudly if no destination
# is set (a /tmp-only "backup" is not a backup). Configure exactly one destination:
# BACKUP_DIR=/mnt/backups                                   # local/mounted dir (not the DB's disk)
# OCI_BUCKET=aprscaching-backups                            # OCI Object Storage (needs the oci CLI)
# BACKUP_BUCKET=aprscaching-backups                         # S3/R2 bucket (needs the aws CLI) …
# R2_ENDPOINT=https://<acct>.r2.cloudflarestorage.com       #   … paired with an S3-compatible endpoint
# BACKUP_RETENTION_DAYS=30                                  # prune snapshots older than this

# ---- AGPL §13 source link ----
# The instance auto-stamps its commit from git when run from a clone. If you MODIFY the code, set
# SOURCE_REPO to YOUR published fork (and SOURCE_COMMIT if not deploying from git).
# SOURCE_REPO=https://github.com/<you>/aprscaching
# SOURCE_COMMIT=
