# Written by ./setup.sh — run it first; it fills everything a working instance needs and keeps what is set.

# ---- Public site ----
# What Caddy serves: a hostname ⇒ automatic Let's Encrypt TLS; :80 ⇒ plain http (LAN/off-grid, or behind a
# Cloudflare Tunnel, where TLS ends at Cloudflare's edge).
DOMAIN=:80
# The public origin people open (https://your.host, or http://<LAN address> off-grid). INSTANCE (the
# federation id) and RP_ID (the passkey domain) default to its host; set them only to differ.
# APP_URL=https://aprs.example.net
# INSTANCE=aprs.example.net
# RP_ID=example.net
# Basemap of the embeddable map widget (/embed): a MapLibre style URL, or "offline" for the self-contained
# grid that loads nothing from outside the instance (HAMNET, off-grid). Unset: OpenFreeMap liberty. Extra
# origins the style loads tiles, glyphs or sprites from go in BASEMAP_HOSTS (comma-separated).
# BASEMAP_STYLE=offline
# BASEMAP_HOSTS=

# ---- APRS-IS feed ----
APRSIS_HOST=rotate.aprs2.net
APRSIS_PORT=14580
# your callsign
APRSIS_CALLSIGN=N0CALL
# your APRS-IS passcode
APRSIS_PASSCODE=00000
# example: 300 km around Graz; tune to your area
APRSIS_FILTER=r/47.07/15.42/300
BATCH_MS=2000

# ---- Gateway link ----
# Self-host (this compose stack): http://gateway:8080/ingest   (compose default)
# A remote gateway (the Cloudflare split): https://gateway.<you>.workers.dev/ingest
INGEST_URL=http://gateway:8080/ingest
# REQUIRED — setup.sh generates one (openssl rand -hex 24). Per-operator peer keys for shared gateways.
# It authorises only the ingest plane (packets, outbox, BBS delivery, node mirror, box polling) — never
# operator configuration and never a sign-in session.
INGEST_SECRET=

# ---- Operator & session secrets (gateway only — never give these to an ingest box) ----
# OPERATOR_SECRET authorises the operator's scripts (tools/admin/verify-call.mjs, peer trust, forwarding
# partners/rules, donation confirms) via the x-operator-secret header. Leave it empty to close those
# machine paths; a signed-in, verified sysop still administers the instance from the web.
# setup.sh generates one (openssl rand -hex 24); it must differ from INGEST_SECRET.
OPERATOR_SECRET=
# SESSION_SECRET signs user sessions. Leave it empty and the gateway generates one on first start and
# keeps it beside the database (session.secret in the data volume); set it to pin a value of your own.
# Changing or deleting it signs every user out.
SESSION_SECRET=

# ---- Trust / verification ----
# Tier A (RF-corroborated) is DEFAULT-DENY: a find reaches Tier A only from a frame heard directly by a
# receiving site you operate and attest, delivered by that site's own ingest box (its TNC or MeshCom port,
# RF_SITE_CALL / MESHCOM_NODE). List those callsigns here (comma/space separated). An APRS-IS line naming
# a listed site (`qAR,<site>`) never counts — APRS-IS passcodes are public, so anyone can inject one.
# Leave it EMPTY and NO find reaches Tier A locally. Peer corroboration over federation can still grant
# Tier A independently.
# FIRST_PARTY_SITES=OE8XXX,OE8YYY

# ---- Position storage (gateway only; see docs/reference/cloudflare-costs.md "Cost on D1") ----
# A fix is stored once its station has moved POS_MIN_MOVE_M metres or POS_MIN_INTERVAL_S seconds have passed
# since its last stored fix. Accounts' calls, registered stations, open finds, living caches and every fix
# heard directly on RF are always stored; every fix still reaches the live map. 0 in either stores every fix.
# POS_MIN_MOVE_M=25
# POS_MIN_INTERVAL_S=600
# Daily D1 write budget (rows a day, from 00:00 UTC): near it the gateway stops storing low-value writes (the
# raw packet log first, then unprotected stations' fixes) and alerts the sysop; protected data is always stored.
# It guards the Cloudflare D1 bill; a self-hosted SQLite file costs the same whatever it writes, so it is off
# here unless set. See docs/reference/cloudflare-costs.md "Write budget". 0 = off.
# D1_DAILY_WRITE_BUDGET=1500000

# ---- Instance operator (see docs/run/first-hour.md) ----
# Your callsign: it administers this instance once you confirm it with tools/admin/verify-call.mjs.
# ADMIN_CALLSIGNS=OE8APR
# Imprint and privacy contact — a public instance must set all three (/imprint, /privacy).
# OPERATOR_NAME=
# OPERATOR_ADDRESS=
# OPERATOR_EMAIL=

# ---- Federation signing key (gateway only) ----
# Signs this instance's feeds so peers can mirror them. setup.sh generates it with
# node tools/fedkey/genkey.mjs --raw; never commit it.
# FED_PRIVATE_KEY=

# ---- Federation posture (gateway only; see docs/run/federation/index.md "Running federation safely") ----
# Only you promote a peer to trusted, and no single peer can lift a find to Tier A.
FED_AUTO_PROMOTE=0
FED_CORROBORATION_QUORUM=2
# Peers you know, as https URLs; they start trusted. Onboard 44Net peers from Instance admin instead.
# FED_PEERS=https://peer.example.org
# Discovery off: learned peers would arrive disabled, still for you to vet.
FED_DISCOVER=0
# A hub (FED_SUBMIT_SECRET set) lists the spoke instance ids allowed to submit to it.
# FED_SUBMIT_INSTANCES=spoke.example.org
# A registry (FED_REGISTRY or FED_REGISTRY_DNS) is refused without its pinned authority key.
# FED_REGISTRY_KEY=

# ---- Email (gateway only; optional) ----
# Sign-in links and the watch-alert digest go out through a Resend-compatible API. Without both values the
# instance sends no mail: members sign in with passkeys (https APP_URL) or, off-grid, with a one-time link
# the operator mints (tools/admin/signin-link.mjs <CALL>). Never set ALLOW_DEV_TOKENS on a real instance —
# it hands sign-in tokens to whoever asks.
# sender address, e.g. aprscaching <noreply@aprs.example.net>
# EMAIL_FROM=
# the provider's API key
# EMAIL_API_KEY=

# ---- Radio transports (optional; see docs/run/radios/rf-ingest.md) ----
# KISS_TNC_HOST=192.168.1.20
# KISS_TNC_PORT=8001
# Names this box as the receiving site of what its own TNC hears directly; list it in FIRST_PARTY_SITES
# for Tier A. Leave it unset when the TNC host is someone else's station (a club digi, a remote node).
# RF_SITE_CALL=OE8APR-10
# MESHCOM_NODE=192.168.1.50=OE8APR-12
# Inside Docker the listener binds the container's own interface; also publish 1799/udp on the ingest service.
# MESHCOM_BIND=0.0.0.0

# ---- Cloudflare Tunnel ingress (self-host without open ports; compose.home.yml) ----
TUNNEL_TOKEN=

# ---- Cloudflare in front of a self-host box (tunnel or proxied DNS) ----
# Keep Cloudflare's cf-connecting-ip as the client address for per-IP rate limits. Set it only when the
# origin is reachable solely through Cloudflare (firewall 80/443 to Cloudflare's ranges); a client that
# reaches the origin directly could otherwise choose its own address. compose.home.yml sets it for the tunnel.
# TRUST_CF=1

# ---- Backups ----
# deploy/backup.sh snapshots the SQLite DB nightly and UPLOADS it — it fails loudly if no destination
# is set (a /tmp-only "backup" is not a backup). Configure exactly one destination:
# local/mounted dir (not the DB's disk)
# BACKUP_DIR=/mnt/backups
# OCI Object Storage (needs the oci CLI)
# OCI_BUCKET=aprscaching-backups
# S3/R2 bucket (needs the aws CLI) …
# BACKUP_BUCKET=aprscaching-backups
#   … paired with an S3-compatible endpoint
# R2_ENDPOINT=https://<acct>.r2.cloudflarestorage.com
# BACKUP_DIR snapshots older than this are deleted. Bucket destinations are append-only: expire them
# with a lifecycle rule on the bucket's db/ prefix, or set BACKUP_PRUNE_BUCKET=1 to have the script
# delete them (the bucket key then needs delete permission).
# BACKUP_RETENTION_DAYS=30
# BACKUP_PRUNE_BUCKET=0

# ---- AGPL §13 source link ----
# The instance auto-stamps its commit from git when run from a clone. If you MODIFY the code, set
# SOURCE_REPO to YOUR published fork (and SOURCE_COMMIT if not deploying from git).
# SOURCE_REPO=https://github.com/<you>/aprscaching
# SOURCE_COMMIT=
