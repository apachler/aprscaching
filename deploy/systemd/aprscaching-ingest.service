[Unit]
Description=APRScaching APRS ingest (RF/IS -> gateway)
After=network-online.target aprscaching-gateway.service
Wants=network-online.target
[Service]
WorkingDirectory=/opt/aprscaching
EnvironmentFile=/opt/aprscaching/deploy/.env
# The env file is the gateway's too: the ingest's environment drops every secret the ingest does not read.
# config-blank ingest: the next line is written by tools/config/generate.mjs from the schema
UnsetEnvironment=OPERATOR_SECRET SESSION_SECRET FED_PRIVATE_KEY FED_CORROBORATION_SECRET FED_SUBMIT_SECRET FED_RELAY_SECRET OKAPI_KEY GMA_API_KEY EMAIL_API_KEY SMTP_PASS VAPID_PRIVATE TUNNEL_TOKEN CF_API_TOKEN
ExecStart=/usr/bin/pnpm --filter @aprscaching/ingest start
# Every process of the unit gets the SIGTERM of a stop, node under pnpm included, so the ingest unkeys its PTTs
# and the gateway closes SQLite before they exit.
KillMode=control-group
TimeoutStopSec=20
Restart=always
RestartSec=5
User=aprscaching
# The sandbox: the ingest parses hostile RF and APRS-IS input, so a process that is taken over must not gain
# capabilities, kernel interfaces or other users' files. The file system is read-only to it except data/, where a
# MeshCom transmit audit (MESHCOM_TX_AUDIT) goes, /home is hidden, other processes are invisible, and its own files
# are the service user's alone. The devices and the address families stay open: serial and USB TNCs, soundcards,
# GPIO and USB PTT (character devices), Bluetooth and the network ports are what it runs on. /sys stays readable
# (sound and serial devices are found there); nothing it does writes to it.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/aprscaching/data
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
