[Unit]
Description=APRScaching gateway (Node + SQLite)
After=network-online.target
Wants=network-online.target
[Service]
WorkingDirectory=/opt/aprscaching
# Secrets come from the env file: INGEST_SECRET is required (the gateway refuses to boot without it,
# and Restart=always would otherwise crash-loop every 5 s); OPERATOR_SECRET is optional; an empty
# SESSION_SECRET is generated on first start and kept beside the database (data/session.secret).
EnvironmentFile=/opt/aprscaching/deploy/.env
Environment=DB_PATH=/opt/aprscaching/data/aprscaching.db
Environment=MEDIA_DIR=/opt/aprscaching/data/media
Environment=PORT=8080
# The built web app (pnpm --filter @aprscaching/web build), served on the same origin as the API.
Environment=WEB_DIST=/opt/aprscaching/apps/web/dist
ExecStart=/usr/bin/pnpm --filter @aprscaching/node-gateway start
# Every process of the unit gets the SIGTERM of a stop, node under pnpm included, so the ingest unkeys its PTTs
# and the gateway closes SQLite before they exit.
KillMode=control-group
TimeoutStopSec=20
Restart=always
RestartSec=5
User=aprscaching
# The sandbox: the gateway answers the internet, so a process that is taken over must not rewrite the code it
# runs, its .env or anything else on the host. It may write data/ only (the database, session.secret, media);
# the checkout, the service user's home and the rest of the file system are read-only, /home is hidden, and
# its files are the service user's alone. No MemoryDenyWriteExecute: V8's JIT needs writable code pages.
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/aprscaching/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
