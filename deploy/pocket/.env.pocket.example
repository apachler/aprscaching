# Pocket: the gateway and the ingest on one Android phone in Termux. deploy/pocket/install.sh copies this
# file to ~/.aprscaching/.env on the first run and fills the secrets, the callsign and the paths; a later
# run keeps that file as it is. Both processes read it from the environment, e.g.
#   set -a; . ~/.aprscaching/.env; set +a
# The paths below are Termux's home directory; install.sh writes the real ones.

# ---- Gateway (servers/node) ----
# Ports above 1023 need no root. The Node server listens on every interface of the phone (its hotspot
# included); what a hotspot client may reach is a separate choice from this file.
PORT=8787
# The origin Chrome on the phone opens. http on localhost is a secure context, so passkeys and Web
# Bluetooth work there without TLS. INSTANCE and RP_ID follow its host.
APP_URL=http://localhost:8787
# SQLite database; the gateway applies db/migrations on every start and keeps session.secret beside it.
DB_PATH=/data/data/com.termux/files/home/.aprscaching/aprscaching.db
# Uploaded cache media.
MEDIA_DIR=/data/data/com.termux/files/home/.aprscaching/media
# The built web app, served by the gateway on the same origin as the API (no reverse proxy on the phone).
WEB_DIST=/data/data/com.termux/files/home/aprscaching/apps/web/dist
# Your callsign: it administers this instance once confirmed with tools/admin/verify-call.mjs.
ADMIN_CALLSIGNS=N0CALL
# Authorises the operator's scripts (tools/admin/signin-link.mjs, verify-call.mjs) over loopback. It must
# differ from INGEST_SECRET; install.sh generates it.
OPERATOR_SECRET=
# SESSION_SECRET is not set here: the gateway generates it on first start and keeps it beside the database.
# How long the nightly job keeps the diagnostic tables. A phone keeps them short: the raw packet log 6 h,
# weather and telemetry 7 days, port counters and the node MHeard list 3 days. Logger positions, finds and
# accounts are not affected. Single quotes keep the JSON intact when the file is sourced.
RETENTION='{"packetsHours":6,"sensorDays":7,"portStatsDays":3,"mheardDays":3}'
# The battery saver (with Termux:API) narrows APRS-IS to your own call below this battery percentage on
# battery, and restores the profile when charging or 10 points higher. 0 turns it off.
POCKET_BATTERY_LOW=20
# Field alerts (with Termux:API): 1 makes the phone vibrate for a new direct message to your call;
# POCKET_ALERTS_SPEAK=1 also says who it is from, POCKET_ALERTS_SPEAK_BODY=1 reads the message out too.
POCKET_ALERTS=0
# Federation stays off: without FED_* settings the station neither signs nor syncs with other instances.
# The write budget (D1_DAILY_WRITE_BUDGET) is off on SQLite, which has no per-row cost.

# ---- Ingest (apps/ingest) ----
# The gateway on this phone. install.sh generates the shared secret; the gateway refuses to start without it.
INGEST_URL=http://127.0.0.1:8787/ingest
INGEST_SECRET=
# APRS-IS feed while the phone has a data connection; offline the ingest retries with a backoff.
APRSIS_HOST=rotate.aprs2.net
APRSIS_PORT=14580
APRSIS_CALLSIGN=N0CALL
# -1 logs in receive-only.
APRSIS_PASSCODE=-1
# 300 km around Graz as an example; tune it to where you operate.
APRSIS_FILTER=r/47.07/15.42/300
BATCH_MS=2000
# MeshCom node on the phone's hotspot (ExtUDP to UDP 1799). deploy/pocket/meshcom-setup.sh finds the hotspot,
# suggests a fixed address for the node, prints the commands to enter on the node and writes this line;
# unset, the MeshCom listener is off.
#MESHCOM_NODE=192.168.43.200=N0CALL-12
