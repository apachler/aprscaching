# Serves the built SPA and reverse-proxies dynamic paths to the gateway.
# DOMAIN=:80 -> plain HTTP (local/off-grid). DOMAIN=host -> automatic Let's Encrypt TLS.
{$DOMAIN} {
	encode zstd gzip
	@dynamic path /api/* /auth/* /ws* /ingest /outbox* /federation/* /.well-known/*
	reverse_proxy @dynamic gateway:8080
	root * /srv/web
	try_files {path} /index.html
	file_server
}
