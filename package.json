{
  "name": "aprscaching",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "APRScaching — an APRS geocaching game and ham-radio Shack",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "eslint --config eslint.config.types.mjs --max-warnings 0 .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\"",
    "check": "tools/dev/check.sh",
    "smoke": "tools/dev/smoke.sh",
    "conformance:meshcom": "node tools/conformance/meshcom.mjs",
    "e2e:audio": "node tools/e2e/audio-mic.mjs",
    "e2e:offline": "node tools/e2e/offline-shell.mjs",
    "e2e:tools": "node tools/e2e/tool-sandbox.mjs",
    "verify": "tools/dev/verify.sh",
    "coverage": "vitest run --config vitest.coverage.config.mjs --coverage",
    "dev": "node tools/dev/dev.mjs",
    "dev:preview": "node tools/dev/dev.mjs --preview",
    "dev:peer": "node tools/dev/dev.mjs --peer",
    "dev:admin": "node tools/dev/dev.mjs admin",
    "dev:seed": "node tools/dev/dev.mjs seed",
    "dev:check": "node tools/dev/dev-stack-check.mjs",
    "dev:web": "pnpm --filter @aprscaching/web dev",
    "dev:gateway": "pnpm --filter @aprscaching/node-gateway dev",
    "dev:ingest": "pnpm --filter @aprscaching/ingest dev"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "^4.13.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.3"
  }
}
