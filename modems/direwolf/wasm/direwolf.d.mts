// The Emscripten loader's interface (direwolf.mjs, generated by build.sh): the exports glue.c names.

export interface DirewolfModule {
  HEAPU8: Uint8Array;
  HEAP16: Int16Array;
  stringToNewUTF8(s: string): number;
  _malloc(n: number): number;
  _free(ptr: number): void;
  _dw_in_ptr(): number;
  _dw_in_cap(): number;
  _dwrx_init(sampleRate: number, baud: number, profile: number, fixBits: number, fx25: number, il2p: number): number;
  _dwrx_push(ptr: number, n: number): number;
  _dwrx_out_ptr(): number;
  _dwrx_out_clear(): void;
  _dwrx_dcd(): number;
  _dwtx_init(
    sampleRate: number,
    baud: number,
    mode: number,
    fx25CheckBytes: number,
    il2pMaxFec: number,
    amplitude: number,
  ): number;
  _dwtx_modulate(ptr: number, len: number, txdelayMs: number, txtailMs: number): number;
  _dwtx_out_ptr(): number;
}

export interface DirewolfModuleOptions {
  instantiateWasm(imports: WebAssembly.Imports, receive: (instance: WebAssembly.Instance) => void): object;
}

export default function createModule(options: DirewolfModuleOptions): Promise<DirewolfModule>;
